generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  PENDING_DELETION
  DISABLED
}

enum AccountProvider {
  LOCAL
  GOOGLE
  GITHUB
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum AgeRange {
  AGE_18_24
  AGE_25_34
  AGE_35_44
  AGE_45_54
  AGE_55_PLUS
}

model User {
  id String @id @default(cuid())

  // Identity
  fullName String?
  nickname String?
  ageRange AgeRange?

  // Profile
  avatarUrl String?

  // Account lifecycle
  status              UserStatus @default(ACTIVE)
  deletionRequestedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Authentication
  accounts           Account[]
  refreshTokens      RefreshToken[]
  reactivationTokens ReactivationToken[]

  // Authorization
  userRoles UserRole[]

  // Profile
  categories UserCategory[]
  audiences  UserAudience[]

  // Capability & experience
  contributions UserContribution[]
  experiences   Experience[]

  // Assessment
  assessmentResults AssessmentResult[]

  // Project relationship
  participations Participation[]

  // Community feedback
  feedbackGiven    CommunityFeedback[] @relation("FeedbackReviewer")
  feedbackReceived CommunityFeedback[] @relation("FeedbackReviewedUser")
}

model UserCategory {
  id         String @id @default(cuid())
  userId     String
  categoryId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId], name: "uk_user_category")
  @@index([categoryId])
}

model AudienceType {
  id          String   @id
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  userAudiences UserAudience[]

  @@map("audience_types")
}

model UserAudience {
  id             String @id @default(cuid())
  userId         String
  audienceTypeId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  audienceType AudienceType @relation(fields: [audienceTypeId], references: [id])

  @@unique([userId, audienceTypeId], name: "uk_user_audience")
  @@index([audienceTypeId])
}

model Contribution {
  id          String  @id @default(cuid())
  fieldId     String
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users       UserContribution[]
  assessments Assessment[]

  @@unique([fieldId, name], name: "uk_contribution_field_name")
  @@index([fieldId])
}

model UserContribution {
  id             String  @id @default(cuid())
  userId         String
  contributionId String
  description    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  contribution Contribution @relation(fields: [contributionId], references: [id])

  experiences                Experience[]
  participationContributions ParticipationContribution[]

  @@unique([userId, contributionId], name: "uk_user_contribution")
  @@index([contributionId])
}

enum DurationUnit {
  MONTH
  YEAR
}

model Experience {
  id             String @id @default(cuid())
  userId         String
  contributionId String

  title       String
  description String?

  durationValue Int?
  durationUnit  DurationUnit?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  userContribution UserContribution @relation(fields: [userId, contributionId], references: [userId, contributionId])

  @@index([userId])
  @@index([contributionId])
}

enum AssessmentResultStatus {
  PASSED
  FAILED
}

model Assessment {
  id             String @id @default(cuid())
  contributionId String

  name    String
  version Int

  passingScore  Int
  maxAttempts   Int?
  cooldownHours Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contribution Contribution @relation(fields: [contributionId], references: [id])

  results AssessmentResult[]

  @@unique([contributionId, version], name: "uk_assessment_contribution_version")
  @@index([contributionId])
}

model AssessmentResult {
  id           String @id @default(cuid())
  userId       String
  assessmentId String

  score   Int
  result  AssessmentResultStatus
  takenAt DateTime               @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@index([userId])
  @@index([assessmentId])
}

enum ParticipationIntent {
  JOIN_PROJECT
  BECOME_COFOUNDER
}

enum ParticipationRole {
  FOUNDER
  COFOUNDER
  TEAM_MEMBER
}

enum ParticipationStatus {
  REQUESTED
  ACTIVE
  REJECTED
  CANCELLED
  LEFT
  REMOVED
  COMPLETED
}

model Participation {
  id        String @id @default(cuid())
  userId    String
  projectId String

  intent ParticipationIntent
  role   ParticipationRole
  status ParticipationStatus @default(REQUESTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  contributions ParticipationContribution[]
  feedbacks     CommunityFeedback[]

  @@index([userId])
  @@index([projectId])
}

model ParticipationContribution {
  id                 String @id @default(cuid())
  participationId    String
  userContributionId String

  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  userContribution UserContribution @relation(fields: [userContributionId], references: [id])

  @@unique([participationId, userContributionId], name: "uk_participation_user_contribution")
  @@index([userContributionId])
}

model CommunityFeedback {
  id              String @id @default(cuid())
  participationId String
  reviewerId      String
  reviewedUserId  String

  communication   Int
  reliability     Int
  collaboration   Int
  professionalism Int

  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  reviewer User @relation("FeedbackReviewer", fields: [reviewerId], references: [id])

  reviewedUser User @relation("FeedbackReviewedUser", fields: [reviewedUserId], references: [id])

  @@unique([participationId, reviewerId, reviewedUserId], name: "uk_participation_feedback")
  @@index([reviewerId])
  @@index([reviewedUserId])
}

model Account {
  id                String          @id @default(cuid())
  userId            String
  provider          AccountProvider
  providerAccountId String?
  email             String?
  passwordHash      String?
  status            AccountStatus   @default(ACTIVE)
  deletedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailVerifiedAt DateTime?

  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([provider, email])
  @@index([userId])
  @@index([email])
}

model RefreshToken {
  id        String @id @default(cuid())
  userId    String
  accountId String
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
}

model ReactivationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}
