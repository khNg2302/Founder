generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  PENDING_DELETION
  DISABLED
}

enum AccountProvider {
  LOCAL
  GOOGLE
  GITHUB
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum AgeRange {
  AGE_18_24
  AGE_25_34
  AGE_35_44
  AGE_45_54
  AGE_55_PLUS
}

enum CategoryType {
  FIELD
  INDUSTRY
  NICHE
}

enum ProjectScope {
  INTERNATIONAL
  NATIONAL
  LOCAL
}

enum ProjectStage {
  IDEA
  VALIDATION
  MVP
  ACTIVE
  GROWTH
}

enum ProjectActivityStatus {
  IN_PROGRESS
  PAUSED
  COMPLETED
  CANCELLED
}

enum HumanCriterionStatus {
  YES
  NO
}

enum LocationType {
  COUNTRY
  PROVINCE
  CITY
  DISTRICT
  OTHER
}

enum ParticipationPeriodType {
  UNSPECIFIED
  DURATION
  DATE_RANGE
}

enum ParticipationDurationUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

enum ParticipationIntent {
  JOIN_PROJECT
  BECOME_COFOUNDER
}

enum ParticipationRole {
  FOUNDER
  COFOUNDER
  TEAM_MEMBER
}

enum ParticipationStatus {
  REQUESTED
  ACTIVE
  REJECTED
  CANCELLED
  LEFT
  REMOVED
  COMPLETED
}

enum ProjectStatusIndicatorStatus {
  YES
  NO
}

enum AssessmentQuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
}

enum AssessmentResultStatus {
  PASSED
  FAILED
}

model User {
  id String @id @default(cuid())

  // Identity
  fullName String?
  nickname String?
  ageRange AgeRange?

  // Profile
  avatarUrl String?

  // Account lifecycle
  status              UserStatus @default(ACTIVE)
  deletionRequestedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Authentication
  accounts           Account[]
  refreshTokens      RefreshToken[]
  reactivationTokens ReactivationToken[]

  // Authorization
  userRoles UserRole[]

  // Profile
  categories UserCategory[]
  audiences  UserAudience[]

  // Capability & experience
  contributions UserContribution[]
  experiences   Experience[]

  // Assessment
  assessmentResults AssessmentResult[]

  // Project relationship
  projects       Project[]
  participations Participation[]

  // Community feedback
  feedbackGiven    CommunityFeedback[] @relation("FeedbackReviewer")
  feedbackReceived CommunityFeedback[] @relation("FeedbackReviewedUser")
}

model Category {
  id       String       @id @default(cuid())
  name     String       @db.VarChar(100)
  type     CategoryType
  parentId String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")

  projectCategories ProjectCategory[]

  // Contribution.fieldId references a FIELD category
  contributions Contribution[] @relation("ContributionField")

  @@index([parentId])
  @@index([type])
  @@map("categories")
}

model Project {
  id String @id @default(cuid())

  name        String  @db.VarChar(100)
  description String? @db.VarChar(1000)

  scope          ProjectScope
  stage          ProjectStage
  activityStatus ProjectActivityStatus @map("activity_status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  createdById String @map("created_by")

  investmentGoal String? @map("investment_goal") @db.VarChar(255)

  createdBy User @relation(fields: [createdById], references: [id])

  projectCategories ProjectCategory[]
  projectAudiences  ProjectAudience[]
  projectLocations  ProjectLocation[]
  statusIndicators  ProjectStatusIndicator[]
  humanRequirements HumanRequirement[]

  participations Participation[]

  @@index([createdById])
  @@map("projects")
}

model ProjectCategory {
  id BigInt @id @default(autoincrement())

  projectId  String
  categoryId String

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([projectId, categoryId], name: "uk_project_category")
  @@index([categoryId])
  @@map("project_categories")
}

model Location {
  id       String       @id @default(cuid())
  name     String       @db.VarChar(150)
  type     LocationType
  parentId String?

  parent   Location?  @relation("LocationParent", fields: [parentId], references: [id])
  children Location[] @relation("LocationParent")

  projectLocations ProjectLocation[]

  @@index([parentId])
  @@index([type])
  @@map("locations")
}

model ProjectLocation {
  id String @id @default(cuid())

  projectId  String
  locationId String

  detailLocation String? @map("detail_location") @db.VarChar(500)

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id])

  @@unique([projectId, locationId], name: "uk_project_location")
  @@index([locationId])
  @@map("project_locations")
}

model AudienceType {
  id          String   @id
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @map("created_at")
  updatedAt   DateTime @map("updated_at")

  userAudiences    UserAudience[]
  projectAudiences ProjectAudience[]

  @@map("audience_types")
}

model ProjectAudience {
  id String @id @default(cuid())

  projectId      String
  audienceTypeId String

  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  audienceType AudienceType @relation(fields: [audienceTypeId], references: [id])

  @@unique([projectId, audienceTypeId], name: "uk_project_audience")
  @@index([audienceTypeId])
  @@map("project_audiences")
}

model HumanRequirement {
  id String @id @default(cuid())

  title     String
  projectId String @map("project_id")

  participationPeriodType    ParticipationPeriodType?   @map("participation_period_type")
  participationDurationValue Int?                       @map("participation_duration_value")
  participationDurationUnit  ParticipationDurationUnit? @map("participation_duration_unit")

  participationStartDate DateTime? @map("participation_start_date") @db.Date
  participationEndDate   DateTime? @map("participation_end_date") @db.Date

  participationForm String? @map("participation_form") @db.VarChar(255)

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  criteria HumanCriterion[]

  @@index([projectId])
  @@map("human_requirements")
}

model HumanCriterion {
  id String @id @default(cuid())

  humanRequirementId String @map("human_requirement_id")

  status HumanCriterionStatus
  term   String               @db.VarChar(255)

  humanRequirement HumanRequirement @relation(fields: [humanRequirementId], references: [id], onDelete: Cascade)

  @@unique([humanRequirementId, status, term], name: "uk_human_criterion")
  @@index([humanRequirementId])
  @@map("human_criteria")
}

model ProjectStatusIndicator {
  id String @id @default(cuid())

  projectId String @map("project_id")

  status ProjectStatusIndicatorStatus
  term   String                       @db.VarChar(255)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, status, term], name: "uk_project_status_indicator")
  @@index([projectId])
  @@map("project_status_indicators")
}

model UserCategory {
  id         String @id @default(cuid())
  userId     String
  categoryId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId], name: "uk_user_category")
  @@index([categoryId])
}

model UserAudience {
  id             String @id @default(cuid())
  userId         String
  audienceTypeId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  audienceType AudienceType @relation(fields: [audienceTypeId], references: [id])

  @@unique([userId, audienceTypeId], name: "uk_user_audience")
  @@index([audienceTypeId])
}

model Contribution {
  id          String  @id @default(cuid())
  fieldId     String
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  field Category @relation("ContributionField", fields: [fieldId], references: [id])

  users       UserContribution[]
  assessments Assessment[]

  @@unique([fieldId, name], name: "uk_contribution_field_name")
  @@index([fieldId])
}

model UserContribution {
  id             String  @id @default(cuid())
  userId         String
  contributionId String
  description    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  contribution Contribution @relation(fields: [contributionId], references: [id])

  experiences                Experience[]
  participationContributions ParticipationContribution[]

  @@unique([userId, contributionId], name: "uk_user_contribution")
  @@index([contributionId])
}

enum DurationUnit {
  MONTH
  YEAR
}

model Experience {
  id             String @id @default(cuid())
  userId         String
  contributionId String

  title       String
  description String?

  durationValue Int?
  durationUnit  DurationUnit?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  userContribution UserContribution @relation(fields: [userId, contributionId], references: [userId, contributionId])

  @@index([userId])
  @@index([contributionId])
}

model Assessment {
  id             String @id @default(cuid())
  contributionId String

  name         String
  version      Int
  passingScore Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contribution Contribution @relation(fields: [contributionId], references: [id])

  questions AssessmentQuestion[]
  results   AssessmentResult[]

  @@unique([contributionId, version], name: "uk_assessment_contribution_version")
  @@index([contributionId])
}

model AssessmentQuestion {
  id           String @id @default(cuid())
  assessmentId String

  content String
  type    AssessmentQuestionType
  order   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  options AssessmentOption[]
  answers AssessmentAnswer[]

  @@unique([assessmentId, order], name: "uk_assessment_question_order")
  @@index([assessmentId])
}

model AssessmentOption {
  id         String @id @default(cuid())
  questionId String

  content   String
  isCorrect Boolean
  order     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedBy AssessmentAnswerOption[]

  @@unique([questionId, order], name: "uk_assessment_option_order")
  @@index([questionId])
}

model AssessmentResult {
  id           String @id @default(cuid())
  userId       String
  assessmentId String

  score   Int
  result  AssessmentResultStatus
  takenAt DateTime               @default(now())

  answers AssessmentAnswer[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assessment Assessment @relation(fields: [assessmentId], references: [id])

  @@index([userId])
  @@index([assessmentId])
}

model AssessmentAnswer {
  id                 String @id @default(cuid())
  assessmentResultId String
  questionId         String

  result AssessmentResult @relation(fields: [assessmentResultId], references: [id], onDelete: Cascade)

  question AssessmentQuestion @relation(fields: [questionId], references: [id])

  selectedOptions AssessmentAnswerOption[]

  @@unique([assessmentResultId, questionId], name: "uk_assessment_answer_question")
  @@index([questionId])
}

model AssessmentAnswerOption {
  answerId String
  optionId String

  answer AssessmentAnswer @relation(fields: [answerId], references: [id], onDelete: Cascade)

  option AssessmentOption @relation(fields: [optionId], references: [id])

  @@id([answerId, optionId])
  @@index([optionId])
}

model Participation {
  id        String @id @default(cuid())
  userId    String
  projectId String

  intent ParticipationIntent
  role   ParticipationRole
  status ParticipationStatus @default(REQUESTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  contributions ParticipationContribution[]
  feedbacks     CommunityFeedback[]

  @@index([userId])
  @@index([projectId])
}

model ParticipationContribution {
  id                 String @id @default(cuid())
  participationId    String
  userContributionId String

  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  userContribution UserContribution @relation(fields: [userContributionId], references: [id])

  @@unique([participationId, userContributionId], name: "uk_participation_user_contribution")
  @@index([userContributionId])
}

model CommunityFeedback {
  id              String @id @default(cuid())
  participationId String
  reviewerId      String
  reviewedUserId  String

  communication   Int
  reliability     Int
  collaboration   Int
  professionalism Int

  comment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participation Participation @relation(fields: [participationId], references: [id], onDelete: Cascade)

  reviewer User @relation("FeedbackReviewer", fields: [reviewerId], references: [id])

  reviewedUser User @relation("FeedbackReviewedUser", fields: [reviewedUserId], references: [id])

  @@unique([participationId, reviewerId, reviewedUserId], name: "uk_participation_feedback")
  @@index([reviewerId])
  @@index([reviewedUserId])
}

model Account {
  id                String          @id @default(cuid())
  userId            String
  provider          AccountProvider
  providerAccountId String?
  email             String?
  passwordHash      String?
  status            AccountStatus   @default(ACTIVE)
  deletedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailVerifiedAt DateTime?

  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([provider, email])
  @@index([userId])
  @@index([email])
}

model RefreshToken {
  id        String @id @default(cuid())
  userId    String
  accountId String
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([accountId])
}

model ReactivationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  accountId String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}
